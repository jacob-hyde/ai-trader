{
  "name": "ai-trader",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "engine": "pnpm --filter @trader/engine dev",
    "alpaca:smoke": "pnpm --filter @trader/engine alpaca:smoke",
    "migrate:up": "pnpm --filter @trader/data migrate:up",
    "migrate:down": "pnpm --filter @trader/data migrate:down",
    "migrate:status": "pnpm --filter @trader/data migrate:status",
    "migrate:create": "pnpm --filter @trader/data migrate:create",
    "bars": "pnpm --filter @trader/data bars"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
