# Copy to .env and fill in. .env is gitignored and must never be committed.

# backtest | paper | live. Live additionally requires LIVE_TRADING_ACK=I_UNDERSTAND until 2FA gating lands.
TRADING_MODE=paper

# Alpaca. Paper keys start with PK, live keys with AK. Base URL selects the environment.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Local stack (docker compose)
DB_USER=trader
DB_PASSWORD=trader
DB_NAME=trader
DATABASE_URL=postgres://trader:trader@localhost:5432/trader
REDIS_URL=redis://localhost:6379

# Push alerts (ntfy topic name; leave blank to disable)
NTFY_TOPIC=
