# Copy to .env and fill in. .env is gitignored and must never be committed.

# backtest | paper | live. Live additionally requires LIVE_TRADING_ACK=I_UNDERSTAND until 2FA gating lands.
TRADING_MODE=paper

# Alpaca. Paper keys start with PK, live keys with AK. Base URL selects the environment.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Local stack (docker compose). DB_PORT is the host port; 5433 avoids clashing with a local Postgres.
DB_USER=trader
DB_PASSWORD=trader
DB_NAME=trader
DB_PORT=5433
REDIS_URL=redis://localhost:6379

# Two roles, one database. The engine is data-only; only the migration runner owns the schema.
DATABASE_URL=postgres://trader_engine:trader_engine@localhost:5433/trader
MIGRATION_DATABASE_URL=postgres://trader:trader@localhost:5433/trader

# Push alerts (ntfy topic name; leave blank to disable)
NTFY_TOPIC=
